<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Encryption export: the app only uses the encryption of the operating system. -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <!-- Interface language: the development language is English; the app offers an English and a Turkish interface (texts in
       app/i18n/, no lproj folder: CFBundleLocalizations declares the "manually managed" localizations). The system items
       macOS adds (Close All, the Open/Save dialog buttons) use the language from this list that matches the system language. -->
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>tr</string>
  </array>
</dict>
</plist>
