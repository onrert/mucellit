<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- YALNIZ SINAMA (elle senaryo S12): Entitlements.local.plist ile aynı, ama
     com.apple.security.files.bookmarks.app-scope YOK. Güncel macOS'ta yer imi için bu anahtar gerçekten gerekli mi
     sorusunu yanıtlamak için ikinci yerel derleme. Dağıtıma girmez. -->
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.print</key>
  <true/>
  <!-- WKWebView içerik yüklemesi sandbox'ta bunu istiyor (kök neden: WebKit yardımcı süreçleri). -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
