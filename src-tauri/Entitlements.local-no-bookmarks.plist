<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- TEST ONLY (manual scenario S12): the same as Entitlements.local.plist, but WITHOUT
     com.apple.security.files.bookmarks.app-scope. A second local build to answer whether this key is really needed for
     bookmarks on current macOS. Not distributed. -->
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.print</key>
  <true/>
  <!-- WKWebView content loading asks for this in the sandbox (root cause: the WebKit helper processes). -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
