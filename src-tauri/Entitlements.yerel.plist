<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Yerel sandbox denemesi: profil gerektirmeyen anahtarlar
     (kimlik ve ekip tanımlayıcısı gibi profil isteyen anahtarlar bu dosyada yok). -->
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>
  <key>com.apple.security.print</key>
  <true/>
  <!-- WKWebView içerik yüklemesi sandbox'ta bunu istiyor (gözlemi, kök neden araştırılıyor). -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
